# WooCommerce / WordPress backend
# Required for checkout to work. Point this at your WooCommerce site.
WORDPRESS_URL=https://api.altrpeptides.com

# Authentication — choose ONE of the two methods below:

# METHOD A: WooCommerce Consumer Key + Secret
# Generate in WP Admin → WooCommerce → Settings → Advanced → REST API
WOOCOMMERCE_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# METHOD B: WordPress Application Password (works with api-lockdown.php)
# Generate in WP Admin → Users → Profile → Application Passwords
# Username must be an admin with manage_woocommerce capability
WORDPRESS_USERNAME=realadmin
WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Google Analytics (optional)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Meta Pixel + Conversions API (optional, server-side only — no NEXT_PUBLIC_ prefix)
# META_PIXEL_ID=1234567890
# META_CAPI_TOKEN=EAAxxxxxxx

# Analytics (optional — self-hosted, server-side only)
# 1. Create a free Supabase project at https://supabase.com
# 2. Run the SQL in supabase-analytics-migration.sql in the Supabase SQL Editor
# 3. Copy the Project URL and service_role key from Project Settings → API
# 4. Set a password for the dashboard at /admin/analytics
# ANALYTICS_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# ANALYTICS_SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# ANALYTICS_PASSWORD=your-dashboard-password

# Google Places reviews (optional, server-side only)
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACE_ID=
# DEMO_REVIEWS=true
